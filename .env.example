APP_NAME="Gestor Comercial SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Argentina/Buenos_Aires
SUPER_ADMIN_EMAIL=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestor_comercial_saas
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=-03:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
NOTIFICATIONS_QUEUE=notifications

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=failover_cloud
MAIL_SCHEME=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@comerstock.com
MAIL_PASSWORD=
MAIL_VERIFY_PEER=true
MAIL_AUTO_TLS=true
MAIL_FROM_ADDRESS="notificaciones@comerstock.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FISCAL_ENABLED=false
FISCAL_API_BASE_URL=http://127.0.0.1:8000/api
FISCAL_API_TOKEN=un-token-largo-seguro
FISCAL_API_TIMEOUT=60
FISCAL_API_CONNECT_TIMEOUT=3
FISCAL_ENVIRONMENT=testing
FISCAL_DEFAULT_POINT_OF_SALE=2
FISCAL_DEFAULT_CONDITION=monotributo
FISCAL_DEFAULT_DOCUMENT_TYPE=invoice_c
FISCAL_DEFAULT_CBTE_TYPE=11
FISCAL_DEFAULT_CONCEPT=1
FISCAL_DEFAULT_AUTHORIZATION_MODE=cae
FISCAL_DEFAULT_VAT_TREATMENT=gravado
FISCAL_DEFAULT_VAT_RATE=21
FISCAL_ACTIVITIES=

MERCADO_PAGO_ENVIRONMENT=testing
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_POINT_TERMINAL_ID=NEWLAND_N950__SBX0000001
MERCADO_PAGO_POINT_EXPIRATION_TIME=PT15M
MERCADO_PAGO_POINT_PRINT_ON_TERMINAL=no_ticket
MERCADO_PAGO_PLATFORM_ID=
MERCADO_PAGO_INTEGRATOR_ID=
MERCADO_PAGO_SPONSOR_ID=
MERCADO_PAGO_TIMEOUT=30
MERCADO_PAGO_CONNECT_TIMEOUT=5

VITE_APP_NAME="${APP_NAME}"
